+DM32UVSettingsExtension *
+DM32UVCodeplug::GeneralSettingsElement::extension() const {
+  typedef DM32UVSettingsExtension Ext;
+  Ext *e = new Ext();
+
+  e->setAutoPowerOff(enumFromRaw(getUInt8(Offset::autoPowerOffDelay()), 5, Ext::AutoPowerOff::Off));
+  e->setFMRogerTone(enumFromRaw(getUInt2(Offset::fmRogerTone()), 2, Ext::FMRogerTone::Off));
+  e->enableGroupCallTone(groupCallToneEnabled());
+  e->enableLowBatteryTone(lowBatteryToneEnabled());
+  e->enableShowVolumeChange(showVolmueChange());
+  e->enableShowClock(showClock());
+  e->setDateFormat(getBit(Offset::dateFormat()) ? Ext::DateFormat::DayMonthYear : Ext::DateFormat::YearMonthDay);
+  e->setBacklightDuration(enumFromRaw(getUInt8(Offset::backlightDuration()), 11, Ext::BacklightDuration::Sec5));
+  e->setCallColor(enumFromRaw(getUInt8(Offset::callColor()), 7, Ext::Color::Cyan));
+  e->setStandbyColor(enumFromRaw(getUInt8(Offset::standbyColor()), 7, Ext::Color::Green));
+  e->setChannelNameAColor(enumFromRaw(getUInt8(Offset::channelNameAColor()), 7, Ext::Color::Orange));
+  e->setChannelNameBColor(enumFromRaw(getUInt8(Offset::channelNameBColor()), 7, Ext::Color::Yellow));
+  e->setZoneNameAColor(enumFromRaw(getUInt8(Offset::zoneNameAColor()), 7, Ext::Color::Blue));
+  e->setZoneNameBColor(enumFromRaw(getUInt8(Offset::zoneNameBColor()), 7, Ext::Color::Red));
+  e->setPositionFormat(getBit(Offset::positionFormat())
+                       ? Ext::PositionFormat::DegreesMinutesSeconds : Ext::PositionFormat::DecimalDegrees);
+  e->enableRecording(recordingEnabled());
+  e->setRecordMode(enumFromRaw(getUInt2(Offset::recordMode()), 2, Ext::RecordMode::Receive));
+  if (Limit::activeRetires().in(getUInt8(Offset::activeReties())))
+    e->setActiveRetries(getUInt8(Offset::activeReties()));
+  e->enableRadioDisableDecode(dmrRemoteKillEnabled());
+  e->enableRemoteMonitorDecode(dmrRemoteMonitorEnabled());
+  e->enableCallAlertDecode(dmrRXAlertEnabled());
+  e->enableRadioEnableDecode(dmrRemoteReenableEnabled());
+  e->enableRadioCheckDecode(dmrRemoteRadioCheckEnabled());
+  e->enableMissedCallAlert(missedCallNotificationEnabled());
+  e->enableOnlyChannelMode(vfoModeDisabled());
+  e->setDisplayModeA(getBit(Offset::displayModeA()) ? Ext::DisplayMode::ChannelName : Ext::DisplayMode::Frequency);
+  e->setDisplayModeB(getBit(Offset::displayModeB()) ? Ext::DisplayMode::ChannelName : Ext::DisplayMode::Frequency);
+  e->setDualWatchMode(enumFromRaw(getUInt2(Offset::dualStandbyMode()), 2, Ext::DualWatchMode::DoubleStandby));
+  e->disableAllLEDs(allLEDsDisabled());
+  e->enableWeatherAlarm(weatherAlarmEnabled());
+  e->setPowerSave(enumFromRaw(getUInt2(Offset::powerSaveMode()), 3, Ext::PowerSave::Off));
+  e->setTailNoiseReduction(enumFromRaw(getUInt2(Offset::steMode()), 3, Ext::TailNoiseReduction::Off));
+  e->setTBST(enumFromRaw(getUInt2(Offset::tbstFrequency()), 3, Ext::TBST::Hz1750));
+
+  // Step 2: the manufacturer's CPS shows raw 0..25 as UTC-12..UTC+13, raw 5..255 as seconds,
+  // raw 0..5 as brightness 1..6 and raw 1..151 as 300..4800 ms in steps of 30 ms.
+  unsigned int zone = getUInt8(Offset::timeZone());
+  if (zone <= 25)
+    e->setUTCOffset((int)zone - 12);
+  unsigned int interval = getUInt8(Offset::posUpdatePeriod());
+  if (interval >= 5)
+    e->setGPSIntervalSeconds(interval);
+  unsigned int brightness = getUInt8(Offset::displayBrightness());
+  if (brightness <= 5)
+    e->setBacklightBrightness(brightness + 1);
+  unsigned int wait = getUInt8(Offset::activeWaitTime());
+  if ((wait >= 1) && (wait <= 151))
+    e->setActiveWaitTimeMs((wait-1)*30 + 300);
+  return e;
+}
