+namespace {
+/** Converts a raw value into an enum value, or returns the fallback if the raw value is not
+ * in the known range [0, max]. */
+template <class E>
+E enumFromRaw(unsigned int raw, unsigned int max, E fallback) {
+  return (raw <= max) ? static_cast<E>(raw) : fallback;
+}
+}
