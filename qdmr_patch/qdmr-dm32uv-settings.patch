+      if (ChannelExtensionElement(fresh.data()).encode(ctx.get<Channel>(i), ctx, err)
+          && ChannelExtensionElement(before.data()).encode(_previous->config.channelList()->channel(priorOf[i]), *_previous->ctx, e)) {
+        uint8_t *real = data(addr);
+        const std::vector<uint8_t> &old = _previous->extensions[priorOf[i]];
+        for (unsigned int b=0; b<ChannelExtensionElement::size(); b++) {
+          uint8_t changed = fresh[b] ^ before[b];
+          real[b] = (old[b] & ~changed) | (fresh[b] & changed);
+        }
+        continue;
+      }
+    }
     if (! ChannelExtensionElement(data(addr)).encode(ctx.get<Channel>(i), ctx, err)) {
       errMsg(err) << "Cannot encode channel extension at index " << i << ".";
       return false;
