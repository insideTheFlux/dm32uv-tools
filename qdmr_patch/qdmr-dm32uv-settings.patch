+void
+DM32UVCodeplug::GeneralSettingsElement::applyExtension(const DM32UVSettingsExtension *ext) {
+  typedef DM32UVSettingsExtension Ext;
+  if (nullptr == ext)
+    return;
+  // What the radio holds now, in the same representation as the extension.
+  std::unique_ptr<Ext> cur(extension());
+
+  if (ext->autoPowerOff() != cur->autoPowerOff())
+    setUInt8(Offset::autoPowerOffDelay(), (unsigned int)ext->autoPowerOff());
+  if (ext->fmRogerTone() != cur->fmRogerTone())
+    setUInt2(Offset::fmRogerTone(), (unsigned int)ext->fmRogerTone());
+  if (ext->groupCallTone() != cur->groupCallTone())
+    enableGroupCallTone(ext->groupCallTone());
+  if (ext->lowBatteryTone() != cur->lowBatteryTone())
+    enableLowBatteryTone(ext->lowBatteryTone());
+  if (ext->showVolumeChange() != cur->showVolumeChange())
+    enableShowVolumeChange(ext->showVolumeChange());
+  if (ext->showClock() != cur->showClock())
+    enableShowClock(ext->showClock());
+  if (ext->dateFormat() != cur->dateFormat())
+    setBit(Offset::dateFormat(), Ext::DateFormat::DayMonthYear == ext->dateFormat());
+  if (ext->backlightDuration() != cur->backlightDuration())
+    setUInt8(Offset::backlightDuration(), (unsigned int)ext->backlightDuration());
+  if (ext->callColor() != cur->callColor())
+    setUInt8(Offset::callColor(), (unsigned int)ext->callColor());
+  if (ext->standbyColor() != cur->standbyColor())
+    setUInt8(Offset::standbyColor(), (unsigned int)ext->standbyColor());
+  if (ext->channelNameAColor() != cur->channelNameAColor())
+    setUInt8(Offset::channelNameAColor(), (unsigned int)ext->channelNameAColor());
+  if (ext->channelNameBColor() != cur->channelNameBColor())
+    setUInt8(Offset::channelNameBColor(), (unsigned int)ext->channelNameBColor());
+  if (ext->zoneNameAColor() != cur->zoneNameAColor())
+    setUInt8(Offset::zoneNameAColor(), (unsigned int)ext->zoneNameAColor());
+  if (ext->zoneNameBColor() != cur->zoneNameBColor())
+    setUInt8(Offset::zoneNameBColor(), (unsigned int)ext->zoneNameBColor());
+  if (ext->positionFormat() != cur->positionFormat())
+    setBit(Offset::positionFormat(), Ext::PositionFormat::DegreesMinutesSeconds == ext->positionFormat());
+  if (ext->recordingEnabled() != cur->recordingEnabled())
+    enableRecording(ext->recordingEnabled());
+  if (ext->recordMode() != cur->recordMode())
+    setUInt2(Offset::recordMode(), (unsigned int)ext->recordMode());
+  if (ext->activeRetries() != cur->activeRetries())
+    setUInt8(Offset::activeReties(), Limit::activeRetires().limit(ext->activeRetries()));
+  if (ext->radioDisableDecode() != cur->radioDisableDecode())
+    enableDMRRemoteKill(ext->radioDisableDecode());
+  if (ext->remoteMonitorDecode() != cur->remoteMonitorDecode())
+    enableDMRRemoteMonitor(ext->remoteMonitorDecode());
+  if (ext->callAlertDecode() != cur->callAlertDecode())
+    enableDMRRXAlert(ext->callAlertDecode());
+  if (ext->radioEnableDecode() != cur->radioEnableDecode())
+    enableDMRRemoteReenable(ext->radioEnableDecode());
+  if (ext->radioCheckDecode() != cur->radioCheckDecode())
+    enableDMRRemoteRadioCheck(ext->radioCheckDecode());
+  if (ext->missedCallAlert() != cur->missedCallAlert())
+    enableMissedCallNotification(ext->missedCallAlert());
+  if (ext->onlyChannelMode() != cur->onlyChannelMode())
+    disableVFOMode(ext->onlyChannelMode());
+  if (ext->displayModeA() != cur->displayModeA())
+    setBit(Offset::displayModeA(), Ext::DisplayMode::ChannelName == ext->displayModeA());
+  if (ext->displayModeB() != cur->displayModeB())
+    setBit(Offset::displayModeB(), Ext::DisplayMode::ChannelName == ext->displayModeB());
+  if (ext->dualWatchMode() != cur->dualWatchMode())
+    setUInt2(Offset::dualStandbyMode(), (unsigned int)ext->dualWatchMode());
+  if (ext->allLEDsDisabled() != cur->allLEDsDisabled())
+    disableAllLEDs(ext->allLEDsDisabled());
+  if (ext->weatherAlarm() != cur->weatherAlarm())
+    enableWeatherAlarm(ext->weatherAlarm());
+  if (ext->powerSave() != cur->powerSave())
+    setUInt2(Offset::powerSaveMode(), (unsigned int)ext->powerSave());
+  if (ext->tailNoiseReduction() != cur->tailNoiseReduction())
+    setUInt2(Offset::steMode(), (unsigned int)ext->tailNoiseReduction());
+  if (ext->tbst() != cur->tbst())
+    setUInt2(Offset::tbstFrequency(), (unsigned int)ext->tbst());
+
+  if (ext->utcOffset() != cur->utcOffset())
+    setUInt8(Offset::timeZone(), (unsigned int)(ext->utcOffset() + 12));
+  if (ext->gpsIntervalSeconds() != cur->gpsIntervalSeconds())
+    setUInt8(Offset::posUpdatePeriod(), ext->gpsIntervalSeconds());
+  if (ext->backlightBrightness() != cur->backlightBrightness())
+    setUInt8(Offset::displayBrightness(), ext->backlightBrightness() - 1);
+  if (ext->activeWaitTimeMs() != cur->activeWaitTimeMs())
+    setUInt8(Offset::activeWaitTime(), (ext->activeWaitTimeMs() - 300)/30 + 1);
+}
