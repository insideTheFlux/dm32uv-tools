+/* ******************************************************************************************** *
+ * Keeping what the user did not change when the radio's codeplug is updated
+ * ******************************************************************************************** */
+struct DM32UVCodeplug::Previous {
+  /** The radio's current codeplug, decoded. */
+  Config config;
+  /** The index tables made while decoding. They number every object like the radio does (by its
+   * slot), not like a configuration that is encoded anew. Encoding an old object with them gives
+   * back the bits that are in the radio. */
+  std::unique_ptr<Context> ctx;
+  /** Index tables numbered like a configuration that is encoded anew (see index()). The settings
+   * elements are encoded with these, because that is what the new configuration gets too. Settings
+   * QDMR cannot encode from such tables (the APRS system, for instance) then come out equal for the
+   * previous and the new configuration and stay as they are in the radio. */
+  std::unique_ptr<Context> ictx;
+  /** The raw channel records by channel index. */
+  std::vector<std::vector<uint8_t>> channels;
+  /** The raw channel extension records (TX contact) by channel index. */
+  std::vector<std::vector<uint8_t>> extensions;
+  /** Marks previous channels that are already assigned to a channel of the new configuration. */
+  std::vector<bool> used;
+};
+
+DM32UVCodeplug::Previous *
+DM32UVCodeplug::capturePrevious(const ErrorStack &err) {
+  Q_UNUSED(err)
+  if (! isAllocated(Offset::channelBanks()))
+    return nullptr;
+
+  std::unique_ptr<Previous> prev(new Previous());
+  ErrorStack e;
+  prev->ctx.reset(new Context(&prev->config));
+  prev->ctx->remTable(&BasicEncryptionKey::staticMetaObject, true);
+  prev->ctx->remTable(&ARC4EncryptionKey::staticMetaObject, true);
+  prev->ctx->remTable(&AESEncryptionKey::staticMetaObject, true);
+  prev->ctx->addTable(&EncryptionKey::staticMetaObject);
+  if (! decodeElements(*prev->ctx, e)) {
+    logDebug() << "Cannot decode the current codeplug: " << e.format();
+    return nullptr;
+  }
+  if (! linkElements(*prev->ctx, e)) {
+    logDebug() << "Cannot link the current codeplug: " << e.format();
+    return nullptr;
+  }
+
+  prev->ictx.reset(new Context(&prev->config));
+  prev->ictx->remTable(&BasicEncryptionKey::staticMetaObject, true);
+  prev->ictx->remTable(&ARC4EncryptionKey::staticMetaObject, true);
+  prev->ictx->remTable(&AESEncryptionKey::staticMetaObject, true);
+  prev->ictx->addTable(&EncryptionKey::staticMetaObject);
+  if (! index(&prev->config, *prev->ictx, e)) {
+    logDebug() << "Cannot index the current codeplug: " << e.format();
+    prev->ictx.reset();   // settings are then encoded as before
+  }
+
+  // Copy the raw records of all channels before anything is overwritten.
+  unsigned int n = prev->config.channelList()->count();
+  for (unsigned int i=0; i<n; i++) {
+    unsigned int blockNumber  = ChannelBankElement::channelBank(i);
+    unsigned int indexInBlock = ChannelBankElement::indexInBank(i);
+    uint32_t addr = Offset::channelBanks()
+                    + (0 == blockNumber ? ChannelBankElement::Offset::channelBlock0()
+                                        : blockNumber * ChannelBankElement::Offset::betweenChannelBlocks())
+                    + indexInBlock * ChannelElement::size();
+    if (! isAllocated(addr))
+      return nullptr;
+    uint8_t *rec = data(addr);
+    prev->channels.emplace_back(rec, rec + ChannelElement::size());
+
+    unsigned int extBlock = i / ChannelExtensionBankElement::Limit::count();
+    unsigned int extIndex = i % ChannelExtensionBankElement::Limit::count();
+    uint32_t extAddr = Offset::channelExtensionBanks()
+                       + extBlock * ChannelExtensionBankElement::Offset::betweenBanks()
+                       + extIndex * ChannelExtensionElement::size();
+    if (! isAllocated(extAddr))
+      return nullptr;
+    uint8_t *ext = data(extAddr);
+    prev->extensions.emplace_back(ext, ext + ChannelExtensionElement::size());
+  }
+  prev->used.assign(n, false);
+  return prev.release();
+}
