new file mode 100644
index 0000000..602fa1a
--- /dev/null
+++ b/lib/dm32uv_extension.hh
@@ -0,0 +1,320 @@
+#ifndef DM32UVEXTENSION_HH
+#define DM32UVEXTENSION_HH
+
+#include "configobject.hh"
+#include "interval.hh"
+
+
+/** Additional general settings of the Baofeng DM-32UV that are stored in the radio but are not
+ * part of the common radio settings.
+ *
+ * The properties are grouped like the tabs of the manufacturer's CPS ("Optional Features"). Each
+ * property maps to exactly one field of the radio's general settings block. If the extension is
+ * absent from a codeplug, the corresponding fields in the radio are left untouched when writing.
+ *
+ * @ingroup dm32uv */
+class DM32UVSettingsExtension: public ConfigExtension
+{
+  Q_OBJECT
+
+  /* Power on/off */
+  /** Automatic power-off delay. */
+  Q_PROPERTY(AutoPowerOff autoPowerOff READ autoPowerOff WRITE setAutoPowerOff)
+
+  /* Alert tones */
+  /** Roger tone on analog channels. */
+  Q_PROPERTY(FMRogerTone fmRogerTone READ fmRogerTone WRITE setFMRogerTone)
+  /** If @c true, a tone is played on incoming group calls. */
+  Q_PROPERTY(bool groupCallTone READ groupCallTone WRITE enableGroupCallTone)
+  /** If @c true, a tone warns of a low battery. */
+  Q_PROPERTY(bool lowBatteryTone READ lowBatteryTone WRITE enableLowBatteryTone)
+
+  /* Display */
+  /** If @c true, a volume change is shown on the display. */
+  Q_PROPERTY(bool showVolumeChange READ showVolumeChange WRITE enableShowVolumeChange)
+  /** If @c true, the time is shown on the display. */
+  Q_PROPERTY(bool showClock READ showClock WRITE enableShowClock)
+  /** The date display format. */
+  Q_PROPERTY(DateFormat dateFormat READ dateFormat WRITE setDateFormat)
+  /** The time the backlight stays on. */
+  Q_PROPERTY(BacklightDuration backlightDuration READ backlightDuration WRITE setBacklightDuration)
+  /** Display color of calls. */
+  Q_PROPERTY(Color callColor READ callColor WRITE setCallColor)
+  /** Color of the characters on the standby screen. */
+  Q_PROPERTY(Color standbyColor READ standbyColor WRITE setStandbyColor)
+  /** Color of the channel name of VFO A. */
+  Q_PROPERTY(Color channelNameAColor READ channelNameAColor WRITE setChannelNameAColor)
+  /** Color of the channel name of VFO B. */
+  Q_PROPERTY(Color channelNameBColor READ channelNameBColor WRITE setChannelNameBColor)
+  /** Color of the zone name of VFO A. */
+  Q_PROPERTY(Color zoneNameAColor READ zoneNameAColor WRITE setZoneNameAColor)
+  /** Color of the zone name of VFO B. */
+  Q_PROPERTY(Color zoneNameBColor READ zoneNameBColor WRITE setZoneNameBColor)
+
+  /* GPS */
+  /** The format of positions on the display. */
+  Q_PROPERTY(PositionFormat positionFormat READ positionFormat WRITE setPositionFormat)
+
+  /* Record */
+  /** If @c true, recording is enabled. */
+  Q_PROPERTY(bool recordingEnabled READ recordingEnabled WRITE enableRecording)
+  /** What is recorded. */
+  Q_PROPERTY(RecordMode recordMode READ recordMode WRITE setRecordMode)
+
+  /* Digital */
+  /** Number of retries when waiting for an answer to an active call [1,8]. */
+  Q_PROPERTY(unsigned int activeRetries READ activeRetries WRITE setActiveRetries)
+  /** If @c true, the radio reacts to a "radio disable" command. */
+  Q_PROPERTY(bool radioDisableDecode READ radioDisableDecode WRITE enableRadioDisableDecode)
+  /** If @c true, the radio reacts to a "remote monitor" command. */
+  Q_PROPERTY(bool remoteMonitorDecode READ remoteMonitorDecode WRITE enableRemoteMonitorDecode)
+  /** If @c true, the radio reacts to a "call alert" command. */
+  Q_PROPERTY(bool callAlertDecode READ callAlertDecode WRITE enableCallAlertDecode)
+  /** If @c true, the radio reacts to a "radio enable" command. */
+  Q_PROPERTY(bool radioEnableDecode READ radioEnableDecode WRITE enableRadioEnableDecode)
+  /** If @c true, the radio reacts to a "radio check" command. */
+  Q_PROPERTY(bool radioCheckDecode READ radioCheckDecode WRITE enableRadioCheckDecode)
+  /** If @c true, missed calls are indicated. */
+  Q_PROPERTY(bool missedCallAlert READ missedCallAlert WRITE enableMissedCallAlert)
+
+  /* Work mode */
+  /** If @c true, only the channel mode can be used (no VFO mode). */
+  Q_PROPERTY(bool onlyChannelMode READ onlyChannelMode WRITE enableOnlyChannelMode)
+  /** What is shown for VFO A. */
+  Q_PROPERTY(DisplayMode displayModeA READ displayModeA WRITE setDisplayModeA)
+  /** What is shown for VFO B. */
+  Q_PROPERTY(DisplayMode displayModeB READ displayModeB WRITE setDisplayModeB)
+  /** Dual-watch (dual-standby) mode. */
