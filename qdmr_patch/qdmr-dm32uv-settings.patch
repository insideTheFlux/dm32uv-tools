+bool
+DM32UVSettingsExtension::parse(const YAML::Node &node, ConfigItem::Context &ctx, const ErrorStack &err) {
+  if (! ConfigItem::parse(node, ctx, err))
+    return false;
+
+  QStringList missing;
+  const QMetaObject *meta = metaObject();
+  for (int p=QObject::staticMetaObject.propertyCount(); p<meta->propertyCount(); p++) {
+    const char *name = meta->property(p).name();
+    if (! node[name].IsDefined())
+      missing.append(name);
+  }
+  // Values outside what the radio can store are refused here, before anything can be written.
+  QStringList bad;
+  if (utcOffset() < -12 || utcOffset() > 13)
+    bad.append("utcOffset (-12 to 13)");
+  if (gpsIntervalSeconds() < 5 || gpsIntervalSeconds() > 255)
+    bad.append("gpsIntervalSeconds (5 to 255)");
+  if (backlightBrightness() < 1 || backlightBrightness() > 6)
+    bad.append("backlightBrightness (1 to 6)");
+  if (activeWaitTimeMs() < 300 || activeWaitTimeMs() > 4800 || 0 != (activeWaitTimeMs()-300) % 30)
+    bad.append("activeWaitTimeMs (300 to 4800 in steps of 30)");
+  if (missing.isEmpty() && ! bad.isEmpty()) {
+    errMsg(err) << node.Mark().line << ":" << node.Mark().column
+                << ": Invalid value in the 'dm32uv' settings section: " << bad.join(", ") << ".";
+    return false;
+  }
+  if (! missing.isEmpty()) {
+    errMsg(err) << node.Mark().line << ":" << node.Mark().column
+                << ": The 'dm32uv' settings section is incomplete. Missing keys: "
+                << missing.join(", ") << ". Provide all keys as written by 'decode', or remove "
+                << "the whole section to leave these radio settings unchanged.";
+    return false;
+  }
+  return true;
+}
