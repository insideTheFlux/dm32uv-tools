+bool
+DM32UVCodeplug::encodeKeepingUnchanged(
+    uint32_t offset, size_t size,
+    const std::function<bool(uint8_t *, Context &, const ErrorStack &)> &fn,
+    Context &ctx, const ErrorStack &err)
+{
+  if ((nullptr == _previous) || (! _previous->ictx))
+    return fn(data(offset), ctx, err);
+
+  // Encode the new and the previous configuration into copies of what the radio holds now. Bits
+  // that come out equal in both were not changed by the user, whatever QDMR makes of them. They
+  // keep the radio's value. (The copies are not empty buffers: encoders that write a value only if
+  // it differs from what is there, like the dm32uv extension, need the real content.)
+  uint8_t *real = data(offset);
+  std::vector<uint8_t> fresh(real, real + size), prior(real, real + size);
+  ErrorStack e;
+  if (! fn(fresh.data(), ctx, err))
+    return false;
+  if (! fn(prior.data(), *_previous->ictx, e))
+    return fn(data(offset), ctx, err);
+
+  for (size_t i=0; i<size; i++) {
+    uint8_t changed = fresh[i] ^ prior[i];
+    real[i] = (real[i] & ~changed) | (fresh[i] & changed);
+  }
+  return true;
+}
